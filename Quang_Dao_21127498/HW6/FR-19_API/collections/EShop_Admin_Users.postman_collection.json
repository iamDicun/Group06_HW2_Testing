{
  "info": {
    "_postman_id": "eshop-admin-users-collection-id",
    "name": "EShop_Admin_Users_FR19",
    "description": "Collection kiểm thử API GET /api/admin/users (FR-19) thuộc hệ thống EShop. Bao gồm 35 test cases cover Schema, Security, Domain Partitions, State Transitions, Data-driven Runs, Mock Servers, và Uptime Monitoring.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_Setup_Admin_Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set('admin_token', jsonData.token);",
              "    console.log('Admin token saved successfully.');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
